# Configure the REAL values in Netlify: Site configuration > Environment variables.
# Never commit real values to the repository.

# --- Razorpay -------------------------------------------------------------
# Go-live: use LIVE keys (Dashboard > Settings > API Keys, Live Mode; they start with rzp_live_).
# While testing, use TEST keys (rzp_test_). Webhook secret: Settings > Webhooks > your webhook.
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
# Set to true at go-live. Then TEST keys can't take orders and a production build with test keys
# or missing settings FAILS instead of silently going live in test mode.
REQUIRE_LIVE_KEYS=false

# --- Supabase (Project Settings > API). The service key is SECRET: Netlify env vars only. ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Telegram alerts (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# --- Forms / spam protection ---
# Any long random string:  openssl rand -hex 32
FORM_TOKEN_SECRET=GENERATE_A_LONG_RANDOM_STRING
# Optional: extra hostnames allowed to submit forms (comma separated). vkphotography.studio and
# *.netlify.app are always allowed.
ALLOWED_ORIGINS=

# --- Quote e-mail (Google Apps Script, see apps-script/Code.gs) ---
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Same value as SHARED_SECRET inside apps-script/Code.gs
APPS_SCRIPT_SECRET=GENERATE_A_LONG_RANDOM_STRING
