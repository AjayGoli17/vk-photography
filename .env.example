# Razorpay TEST MODE credentials — get these from the Razorpay Dashboard
# (Settings > API Keys, Test Mode). Never commit real values.
# Configure the real values in Netlify: Site settings > Environment variables.

RAZORPAY_KEY_ID=YOUR_RAZORPAY_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_TEST_KEY_SECRET

# Settings > Webhooks > (your webhook) > Secret
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_TEST_WEBHOOK_SECRET
