/* 2 equal columns, equal-size cells, no gaps */
:root { --cell-ratio: 4 / 5; }   /* 1 / 1 = square, 4 / 3 = landscape */

#gallery.gallery { display: flex !important; flex-direction: column !important; gap: 2rem !important; }

#gallery .gallery-row {
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  gap: 2rem !important;
  align-items: stretch !important;
}
#gallery .gallery-row:has(> .gallery-item:nth-child(3)) {
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
}

#gallery .gallery-item {
  flex: none !important;
  width: 100% !important;
  min-width: 0 !important;
  margin: 0 !important;
  grid-column: auto !important;
  aspect-ratio: var(--cell-ratio) !important;
  position: relative !important;
}
#gallery .gallery-item .gallery-image-wrapper {
  position: absolute !important; inset: 0 !important;
  width: 100% !important; height: 100% !important;
}
#gallery .gallery-item img {
  position: absolute !important; inset: 0 !important;
  width: 100% !important; height: 100% !important;
  object-fit: cover !important;
  object-position: center 30% !important;
  display: block;
}
@media (max-width: 768px) { #gallery.gallery { gap: .75rem !important; } #gallery .gallery-row { gap: .75rem !important; } }
@media (max-width: 480px) { #gallery.gallery { gap: .5rem !important; }  #gallery .gallery-row { gap: .5rem !important; } }
