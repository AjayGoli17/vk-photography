/* --- Reset & Base Variables --- */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg-color: #FFFFFF;
    --text-main: #2B2620;
    --text-muted: #7A7566;
    --accent: #B08D57; /* Warm gold/bronze */
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Montserrat', sans-serif;
}

body {
    background-color: var(--bg-color);
    color: var(--text-main);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

/* --- Typography --- */
h1, h2, h3 {
    font-family: var(--font-heading);
    font-weight: 400;
}

/* --- Hero Section --- */
.hero {
    height: 60vh; 
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 0 2rem;
    position: relative;
    background: radial-gradient(circle at center, #FFFFFF 0%, #FFFFFF 70%);
}

.hero h1 {
    font-size: clamp(1.4rem, 7vw, 6rem);
    letter-spacing: -1px;
    margin-bottom: 1.2rem;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(40px);
    animation: cinematicReveal 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.2s;
}

.hero p {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--text-muted);
    max-width: 600px;
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(30px);
    animation: cinematicReveal 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.6s;
}

/* --- Gallery Section (Portrait & Landscape Grid) --- */
.gallery-container {
    padding: 3rem 2rem 6rem 2rem; 
    max-width: 1800px;
    margin: 0 auto;
}

.gallery {
    display: grid;
    /* Base column width */
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
}

.gallery-item {
    position: relative;
    overflow: hidden;
    background-color: #D7D2CA;
    opacity: 0;
    transform: translateY(60px);
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
}

.gallery-item {
    aspect-ratio: 4 / 3; /* 1 / 1 = square, 4 / 5 = taller */
}

/* odd photo count: last photo spans both columns, no empty slot */
.gallery-item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    aspect-ratio: 8 / 3;
}

/* Triggered by JS IntersectionObserver */
.gallery-item.is-visible {
    opacity: 1;
    transform: translateY(0);
}

.gallery-image-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    transform: scale(1.18);
    transition: transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
}

.gallery-item.is-visible .gallery-image-wrapper {
    transform: scale(1);
}

.gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    transition: filter 0.8s ease, transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
    filter: none;
    will-change: transform;
}

.item-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 2.5rem;
    background: linear-gradient(to top, rgba(43,38,32,0.92), transparent);
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
    z-index: 2;
}

.item-overlay span {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    color: var(--text-main);
    font-style: italic;
    display: block;
    transform: translateY(15px);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

/* --- Call to Action Section --- */
.cta-section {
    padding: 12rem 2rem;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.cta-divider {
    width: 80px;
    height: 1px;
    background-color: var(--text-main);
    margin: 0 auto;
    opacity: 0.9;
}

.cta-divider.divider-top {
    margin-bottom: 4rem;
}

.cta-divider.divider-bottom {
    margin-top: 4rem;
}

.cta-section h2 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin-bottom: 3rem;
    opacity: 0;
    transform: translateY(50px);
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
}

.cta-section h2.is-visible {
    opacity: 0.9;
    transform: translateY(0);
}

.cta-buttons {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
}

.cta-button {
    display: inline-block;
    padding: 1.4rem 4rem;
    font-size: 0.95rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bg-color);
    background-color: var(--text-main);
    border: 1px solid var(--text-main);
    transition: background-color 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                color 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 1s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(50px);
    will-change: opacity, transform;
}

.cta-button.is-visible {
    opacity: 1;
    transform: translateY(0);
}

.cta-button-secondary {
    opacity: 1 !important;
    transform: translateY(0) !important;
    transition-delay: 0.15s;
}

.cta-button:hover {
    background-color: transparent;
    color: var(--text-main);
    box-shadow: 0 0 30px rgba(176, 141, 87, 0.25);
}

/* --- Animations --- */
@keyframes cinematicReveal {
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* --- Responsive Adjustments --- */
@media (max-width: 768px) {
    .gallery {
        gap: 0.75rem;
    }
    .gallery-container {
        padding: 0.5rem 1rem 3rem 1rem;
    }
    .cta-section {
        padding: 4rem 1.5rem;
    }
    .cta-divider.divider-top {
        margin-bottom: 2rem;
    }
    .cta-button {
        padding: 0.9rem 1.8rem;
        font-size: 0.78rem;
        letter-spacing: 1.2px;
        white-space: nowrap;
    }
    .hero {
        height: 32vh; /* Even tighter on mobile */
        min-height: 260px;
    }
}

@media (max-width: 480px) {
    .gallery {
        gap: 0.5rem;
    }
    .item-overlay {
        padding: 1rem;
    }
    .item-overlay span {
        font-size: 1.1rem;
    }
}
/* ===== GALLERY ROWS (no gaps, no crop) ===== */
.gallery { display:flex !important; flex-direction:column !important; columns:auto !important; gap:2rem !important; }
.gallery-row { display:flex; gap:2rem; align-items:flex-start; }
.gallery-item {
  flex: var(--r) 1 0% !important; min-width:0 !important;
  aspect-ratio: var(--r) !important;
  position:relative !important; width:auto !important; margin:0 !important;
  grid-column:auto !important; break-inside:auto !important;
}
.gallery-item .gallery-image-wrapper { position:absolute !important; inset:0 !important; width:100% !important; height:100% !important; }
.gallery-item img, .gallery-item.wide img {
  position:absolute !important; inset:0 !important; width:100% !important; height:100% !important;
  top:0 !important; object-fit:cover !important; display:block;
}
@media (max-width:768px){ .gallery{gap:.75rem !important;} .gallery-row{gap:.75rem;} }
@media (max-width:480px){ .gallery{gap:.5rem !important;} .gallery-row{gap:.5rem;} }
