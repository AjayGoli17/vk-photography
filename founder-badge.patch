diff --git a/css/founder-badge.css b/css/founder-badge.css
new file mode 100644
index 0000000..165faa8
--- /dev/null
+++ b/css/founder-badge.css
@@ -0,0 +1,60 @@
+/* Founder badge overlapping the hero photo */
+
+/* Let the badge stick out past the photo; clipping moves to an inner wrapper */
+.hero-frame-inner {
+  overflow: visible;
+}
+
+.hero-photo-clip {
+  width: 100%;
+  height: 100%;
+  border-radius: 28px;
+  overflow: hidden;
+}
+
+.founder-badge {
+  position: absolute;
+  right: -40px;
+  bottom: 40px;
+  z-index: 5;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding: 14px 22px;
+  background: var(--cognac, #b9793f);
+  border-radius: 14px;
+  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
+}
+
+.founder-badge__role {
+  font-family: "Space Mono", monospace;
+  font-size: 11px;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+  color: var(--ink, #000);
+}
+
+.founder-badge__name {
+  font-family: "Cormorant Garamond", serif;
+  font-size: 24px;
+  line-height: 1.1;
+  color: var(--ink, #000);
+}
+
+/* Keep the badge inside the screen on tablets and phones */
+@media (max-width: 1100px) {
+  .founder-badge {
+    right: -16px;
+  }
+}
+
+@media (max-width: 860px) {
+  .founder-badge {
+    right: 12px;
+    bottom: 12px;
+    padding: 10px 16px;
+  }
+  .founder-badge__name {
+    font-size: 20px;
+  }
+}
