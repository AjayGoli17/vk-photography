diff --git a/css/hero-tagline.css b/css/hero-tagline.css
new file mode 100644
index 0000000..0d94e96
--- /dev/null
+++ b/css/hero-tagline.css
@@ -0,0 +1,43 @@
+/* Remove the old "Founder & CEO / Vamshi" badge that overlaps the founder photo.
+   The badge is not in index.html, so it is drawn by CSS pseudo-elements (or JS).
+   If it comes from a different selector, delete that rule in css/home.css instead. */
+.hero-frame::before,
+.hero-frame::after,
+.hero-frame-inner::before,
+.hero-frame-inner::after {
+  content: none !important;
+  display: none !important;
+}
+
+/* New plain tagline below the hero paragraph */
+.hero-founder {
+  margin: 28px 0 0;
+}
+.hero-founder::before {
+  content: "";
+  display: block;
+  width: 36px;
+  height: 1px;
+  background: #A8733A; /* same brown as the View Work border */
+  margin-bottom: 12px;
+}
+.hero-founder-role {
+  display: block;
+  font-family: 'Space Mono', monospace;
+  font-size: 12px;
+  letter-spacing: 2px;
+  text-transform: uppercase;
+  color: #A8733A;
+}
+.hero-founder-name {
+  display: block;
+  font-family: 'Cormorant Garamond', Georgia, serif;
+  font-size: 28px;
+  line-height: 1.2;
+  color: #111;
+  margin-top: 2px;
+}
+@media (max-width: 640px) {
+  .hero-founder { margin-top: 20px; }
+  .hero-founder-name { font-size: 24px; }
+}
